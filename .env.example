# ---- Retrieval / indexing ----
# Embedding backend: auto | hashing | sentence-transformers
#   auto  -> use sentence-transformers if installed, else deterministic hashing
#   hashing -> always the offline, dependency-free embedder (used by tests)
EMBEDDING_PROVIDER=auto
# Model used when provider is sentence-transformers (downloaded on first use).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Vector index backend: auto | numpy | faiss
VECTOR_STORE=auto

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Number of chunks retrieved per query
TOP_K=4

# ---- Generation ----
# LLM backend: extractive | openai | huggingface
#   extractive -> offline, key-free grounded answer built from retrieved passages
#   openai / huggingface -> real LLM generation, requires the matching API key
LLM_PROVIDER=extractive
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Only needed if LLM_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ---- Server ----
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins. Use * for the GitHub Pages demo.
CORS_ORIGINS=*
# Where ingested-document metadata and the vector index are persisted.
DATA_DIR=./data
INDEX_DIR=./index
LOG_LEVEL=INFO
